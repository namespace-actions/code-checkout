{
  "name": "code-checkout",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Check out GitHub repositories using Namespace Git snapshots",
  "license": "Apache-2.0",
  "scripts": {
    "build": "ncc build src/main.ts --out dist/main --license licenses.txt",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.4",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
